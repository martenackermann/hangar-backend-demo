{
  "openapi": "3.1.0",
  "info": {
    "title": "Hangar API",
    "summary": "IT-hardware rollout & logistics console (portfolio demo).",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Service health",
        "operationId": "system-health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          },
          "503": {
            "description": "A dependency is unavailable",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthOut"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/jobs/{job_id}": {
      "get": {
        "tags": [
          "jobs"
        ],
        "summary": "Background job status",
        "operationId": "jobs-get_job",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "job_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Job Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/JobOut"
                }
              }
            }
          },
          "401": {
            "description": "Unauthorized",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/files/{token}": {
      "get": {
        "tags": [
          "files"
        ],
        "summary": "Download a file (signed URL)",
        "operationId": "files-download_file",
        "parameters": [
          {
            "name": "token",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Token"
            }
          },
          {
            "name": "inline",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "description": "Render inline instead of as attachment.",
              "default": false,
              "title": "Inline"
            },
            "description": "Render inline instead of as attachment."
          }
        ],
        "responses": {
          "200": {
            "description": "The file",
            "content": {
              "application/octet-stream": {}
            }
          },
          "404": {
            "description": "Not Found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "410": {
            "description": "Gone",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetails"
                }
              }
            }
          },
          "422": {
            "description": "Validation failed",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationProblem"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CheckStatus": {
        "type": "string",
        "enum": [
          "ok",
          "degraded",
          "error"
        ]
      },
      "DatabaseCheck": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          },
          "latencyMs": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Latencyms"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "DatabaseCheck"
      },
      "HealthChecks": {
        "properties": {
          "database": {
            "$ref": "#/components/schemas/DatabaseCheck"
          },
          "jobQueue": {
            "$ref": "#/components/schemas/JobQueueCheck"
          }
        },
        "type": "object",
        "required": [
          "database",
          "jobQueue"
        ],
        "title": "HealthChecks"
      },
      "HealthOut": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          },
          "version": {
            "type": "string",
            "title": "Version"
          },
          "environment": {
            "type": "string",
            "title": "Environment"
          },
          "demoMode": {
            "type": "boolean",
            "title": "Demomode"
          },
          "checks": {
            "$ref": "#/components/schemas/HealthChecks"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version",
          "environment",
          "demoMode",
          "checks"
        ],
        "title": "HealthOut"
      },
      "JobOut": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "task": {
            "type": "string",
            "title": "Task"
          },
          "queue": {
            "type": "string",
            "title": "Queue"
          },
          "status": {
            "$ref": "#/components/schemas/JobStatus"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "scheduledAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduledat"
          },
          "finished": {
            "type": "boolean",
            "title": "Finished"
          }
        },
        "type": "object",
        "required": [
          "id",
          "task",
          "queue",
          "status",
          "attempts",
          "finished"
        ],
        "title": "JobOut"
      },
      "JobQueueCheck": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/CheckStatus"
          },
          "pending": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pending"
          },
          "running": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Running"
          },
          "failed": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Failed"
          },
          "workers": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Workers"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Detail"
          }
        },
        "type": "object",
        "required": [
          "status"
        ],
        "title": "JobQueueCheck"
      },
      "JobStatus": {
        "type": "string",
        "enum": [
          "todo",
          "doing",
          "succeeded",
          "failed",
          "cancelled",
          "aborting",
          "aborted"
        ]
      },
      "ProblemDetails": {
        "additionalProperties": true,
        "description": "RFC 9457 problem details. Extension members may be present.",
        "properties": {
          "type": {
            "default": "about:blank",
            "description": "URI identifying the problem type.",
            "title": "Type",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "requestId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Requestid"
          }
        },
        "required": [
          "title",
          "status"
        ],
        "title": "ProblemDetails",
        "type": "object"
      },
      "ValidationProblem": {
        "additionalProperties": true,
        "properties": {
          "type": {
            "default": "about:blank",
            "description": "URI identifying the problem type.",
            "title": "Type",
            "type": "string"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "instance": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Instance"
          },
          "requestId": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Requestid"
          },
          "errors": {
            "additionalProperties": {
              "items": {
                "type": "string"
              },
              "type": "array"
            },
            "description": "Field path (camelCase, dot-separated) -> messages.",
            "title": "Errors",
            "type": "object"
          }
        },
        "required": [
          "title",
          "status",
          "errors"
        ],
        "title": "ValidationProblem",
        "type": "object"
      }
    },
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "description": "JWT access token from POST /auth/login.",
        "scheme": "bearer"
      }
    }
  }
}
