{% macro button(url, label) -%}
<p style="margin:24px 0;"><a href="{{ url }}" style="display:inline-block;background:#1f3a5f;color:#ffffff;text-decoration:none;padding:12px 22px;border-radius:4px;font-weight:bold;">{{ label }}</a></p>
{%- endmacro %}
{% macro item_list(items) -%}
{% if items %}
<table role="presentation" cellpadding="0" cellspacing="0" style="margin:8px 0 16px;border-collapse:collapse;">
{% for item in items %}
  <tr><td style="padding:4px 12px 4px 0;color:#616e7c;">{{ loop.index }}.</td><td style="padding:4px 0;">{{ item }}</td></tr>
{% endfor %}
</table>
{% endif %}
{%- endmacro %}
{% macro signature(operator_name) -%}
<p style="margin-top:24px;">Kind regards<br>Your rollout team &middot; {{ operator_name }}</p>
{%- endmacro %}
