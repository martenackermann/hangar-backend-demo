# Local development placeholders only. Copy to .env and adjust; never commit .env.
# Defaults match the shared dev containers (Postgres on 5432, Mailpit on 1025/8025).
# Slices: use your own databases/ports from the WORKSPACE table (e.g. hangar_h3, 8103).

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8100
LOG_LEVEL=INFO
# json (default) or console
LOG_FORMAT=console

DATABASE_URL=postgresql+psycopg://dev:dev@localhost:5432/hangar_main
# Used by the test-suite (default: hangar_test on the same server)
TEST_DATABASE_URL=postgresql+psycopg://dev:dev@localhost:5432/hangar_test

# Demo-only secrets (JWT_SECRET needs >= 32 chars). Use long random values anywhere public:
# ENVIRONMENT=production refuses these two values, and with DEMO_MODE=false any value
# containing "change-me", "dev-only" or "demo-only" (both keys then need >= 32 chars).
JWT_SECRET=dev-only-change-me-0123456789abcdef
JWT_TTL_MINUTES=720
FILE_URL_SIGNING_KEY=dev-only-signing-key
# Login throttling (per API process; failed password logins / persona logins per window)
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=300
# LOGIN_RATE_LIMIT_PER_ACCOUNT=10
# LOGIN_RATE_LIMIT_PER_IP=50
# PERSONA_LOGIN_RATE_LIMIT_PER_IP=60
# Behind a reverse proxy: let uvicorn trust its X-Forwarded-For (client IPs for throttling)
# FORWARDED_ALLOW_IPS=127.0.0.1

HANGAR_BUSINESS_TZ=Europe/Zurich
HANGAR_FILES_DIR=var/files
HANGAR_PUBLIC_API_URL=http://localhost:8100/api/v1
# Request limits: JSON bodies; uploads may be IMPORT_MAX_BYTES (+1 MiB); XLSX unpacked size
# MAX_REQUEST_BYTES=2097152
# IMPORT_MAX_BYTES=20971520
# XLSX_MAX_UNCOMPRESSED_BYTES=134217728
# Comma-separated or JSON list of exact origins ('*' is refused; default: localhost 5173-5178)
HANGAR_CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:5176,http://localhost:5177,http://localhost:5178
FRONTEND_URL=http://localhost:5173

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Hangar Rollout Desk <rollout-desk@example.com>
MAIL_TEAM_MAILBOX=rollout-team@example.com
MAIL_ESCALATION_CC=fleet-escalations@example.com
MAIL_PARTNER_ORDERS=partner-orders@example.com
MAILPIT_URL=http://localhost:8025

ITSM_HOLD_ASSIGNMENT_GROUP=Rollout Hardware Hold

# fake (default) | real ; mailer: smtp | memory | console
GATEWAY_BOOKING=fake
GATEWAY_CARRIER=fake
GATEWAY_MAILER=smtp

DEMO_MODE=true
DEMO_NIGHTLY_RESET=false
WORKER_CONCURRENCY=4
