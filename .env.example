# Local development placeholders only. Copy to .env and adjust; never commit .env.
# Defaults match the shared dev containers (Postgres on 5432, Mailpit on 1025/8025).

ENVIRONMENT=development
HOST=127.0.0.1
PORT=8100
LOG_LEVEL=INFO
# json (default) or console
LOG_FORMAT=console

DATABASE_URL=postgresql+psycopg://dev:dev@localhost:5432/hangar_main
# Used by the test-suite (default: hangar_test on the same server)
TEST_DATABASE_URL=postgresql+psycopg://dev:dev@localhost:5432/hangar_test

# Demo-only signing secret (min. 32 chars). Use a long random value anywhere public.
JWT_SECRET=dev-only-jwt-secret-change-me-0123456789abcdef
JWT_TTL_MINUTES=480

SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=Hangar <hangar@example.com>

APP_URL=http://localhost:8100
FRONTEND_URL=http://localhost:5173
# Comma-separated or JSON list
CORS_ORIGINS=http://localhost:5173

DEMO_MODE=true
STORAGE_DIR=storage
STORAGE_MAX_UPLOAD_MB=20
FILE_URL_TTL_SECONDS=900
WORKER_CONCURRENCY=4
